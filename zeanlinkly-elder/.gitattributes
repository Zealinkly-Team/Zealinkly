# Auto detect text files and normalize line endings to LF
* text=auto

# Kotlin files
*.kt text eol=lf
*.kts text eol=lf

# Java files
*.java text eol=lf

# Gradle files
*.gradle text eol=lf
*.gradle.kts text eol=lf
gradlew text eol=lf

# XML files
*.xml text eol=lf

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Properties files
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.apk binary
*.jar binary
*.class binary
*.so binary
*.a binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary

